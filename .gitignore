# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# local tooling — everything under /.claude/ EXCEPT the production skill, which is
# the operating manual for the 267-video catalog and must survive a fresh clone.
# It contains no credentials and no confidential source text.
# (Must be /.claude/* not /.claude/ — git cannot re-include a file inside an
# excluded directory.)
/.claude/*
!/.claude/skills/

# thinkific static export — build artifacts (regenerable from export-thinkific/)
/export-thinkific/node_modules
/export-thinkific/dist
/eximious-claims-investigation-thinkific-html5/
/eximious-claims-investigation-thinkific-html5.zip

# typescript
*.tsbuildinfo
next-env.d.ts

# Eximious authoritative source docs (executed agreement + confidential scripts) — local reference only, never pushed
docs/source/*.pdf

# Contains verbatim confidential pilot-script narration transcribed from docs/source/pilot-scripts.pdf.
# Same confidentiality basis as the source PDFs above — local reference only, never pushed.
docs/VIDEO_1_PRODUCTION_MAP.md
docs/VIDEO_1_GENERATION_CONFIGS.md

# Unredacted originals of artifacts whose tracked versions have had verbatim
# siu-01 / ew-01 pilot-script excerpts removed. Same confidentiality basis as
# docs/source/*.pdf — local reference only, never pushed.
docs/confidential/

# Reproducible deliverable produced by export-thinkific/assemble.mjs (it rmSync's
# and rebuilds this directory on every run). Trailing-number variants are Finder
# duplicates of the same build output.
eximious-claims-investigation-thinkific-html5*/

# Confidential presenter VOICE artifacts — siu-01 / ew-01 pilot-script narration.
# Same confidentiality basis as docs/source/*.pdf: local reference only, never pushed.
#
# Every presenter narration .mp3 is confidential client script text spoken aloud.
public/media/presenter-*.mp3
# Voice auditions and casting samples kept outside public/media. Same basis: an audio file
# of a presenter voice is script text spoken aloud unless proven otherwise.
assets/voices/
#
# Voice casting rounds and superseded candidates. Their sidecars carry the same
# passage verbatim in an `excerpt` field.
public/media/presenter-*-casting-*.json
public/media/presenter-*-voice-approval.json
public/media/presenter-*-marin-*.json
public/media/presenter-*-oai-*.json
public/media/presenter-*-voice-v[0-9].json
#
# NOT confidential and deliberately TRACKED: the two REDACTED *-voice-SELECTED.json
# sidecars carry the locked voice config with the excerpt removed, and CLAUDE.md
# depends on Selena's. These negations are a guard — keep them if the rules above
# are ever broadened.
!public/media/presenter-2-curtis-whitfield-voice-SELECTED.json
!public/media/presenter-3-selena-navarro-voice-SELECTED.json
#
# Also NOT matched, and must stay tracked: presenter-1-diane-* motion-base /
# driving-base / production-still .json .seq .filter .build.py provenance sidecars.

# ---------------------------------------------------------------------------
# Per-video DELIVERABLES produced by export-thinkific/assemble.mjs and
# scripts/package-source.mjs. Both scripts rmSync and rebuild these on every run,
# so they are reproducible from tracked source + tracked media. Together they are
# ~2.7 GB; committing them would bloat the repo permanently for no gain.
EA_*_AV[0-9]/
EA_*_AV[0-9].zip
EA_*_AV[0-9]_source/
EA_*_AV[0-9]_source.zip
# Suffixed variants of the same deliverables — superseded builds kept on disk as the
# archive of what a revision replaced (-mp3audio-SUPERSEDED, -v1-sage-superseded, ...).
# The exact-name rules above do not match a suffix, so each of these 200-270 MB archives
# would otherwise be staged, and GitHub rejects any file over 100 MB outright.
EA_*_AV[0-9]-*.zip
EA_*_AV[0-9]_source-*.zip
# Legacy/superseded package names (the exact-name rules above predate these).
eximious-*-thinkific-html5*.zip

# Superseded delivered media, kept on disk as an archive of what a revision
# replaced. The delivered set that ships is public/media/<lesson>/ only.
public/media/*-superseded/
public/media/*-v[0-9]-superseded/

# Production INTERMEDIATES — motion bases, driving bases and their raw takes.
# They are inputs to the lip-sync pipeline, never served by the player, and the
# Curtis (109.6 MB) and Selena (156.0 MB) driving bases both exceed GitHub's
# 100 MB hard file limit, so a push carrying them is rejected outright.
# Their small .json/.seq/.filter/.build.py provenance sidecars stay tracked.
public/media/presenter-*-driving-base*.mp4
public/media/presenter-*-motion-base*.mp4
